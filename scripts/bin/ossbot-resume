#!/usr/bin/env bash
# ossbot-resume (installed as /opt/ossbot/bin/ossbot-resume; DESIGN 13.2-13.3, N4). Self-contained.
#   ossbot-resume --request                    ossbot-enforce-resume.service: the gatekeeper wrote
#                                              resume-request after a human confirm; verify it (owner
#                                              gatekeeper or root, newer than 'killed'), always consume it
#   ossbot-resume --offline --via V [--actor A] resume.ps1 / ossctl when the gatekeeper is down: append
#                                              one JSON line to resume.log FIRST (the gatekeeper turns it
#                                              into an audit event + Telegram FYI on its next start)
#   ossbot-resume --offline --via backup --paused-only   ossctl backup lifting the pause it set itself:
#                                              the log line (paused_only: true) first, then only 'paused'
#                                              is removed; a kill flag and the marker always stay, and
#                                              no unit is started (a pause stops none)
# Otherwise: remove killed, paused, resume-request and the Windows marker together, and start in order
# gatekeeper, proxy, dockerfilter, sandboxd, runner, hermes, the Hermes probe socket (units that do not
# exist are skipped).
# Dry-run is never changed. Exit 0 done, 1 refused, 3 partial (a unit did not start).
set -uo pipefail

REPO=${OSSBOT_REPO:-/mnt/d/Work/autonomous-oss-contributor}
CONTROL=${OSSBOT_CONTROL_DIR:-/var/lib/ossbot/control}
RESUME_LOG=${OSSBOT_RESUME_LOG:-/srv/ossbot/logs/resume.log}
MARKER="$REPO/.ossbot-local/KILL"
mode="" via="" actor="${SUDO_USER:-root}" paused_only=0
actor_uid=${SUDO_UID:-$EUID}
while (($#)); do
  case $1 in
    --request) mode=request; shift ;;
    --offline) mode=offline; shift ;;
    --via) via=${2:-}; shift 2 ;;
    --actor) actor=${2:-}; shift 2 ;;
    --actor-uid) actor_uid=${2:-}; shift 2 ;;
    # ossctl backup lifting its own pause (DESIGN 18.8): only 'paused' is removed, never 'killed' or the
    # Windows marker, so a kill that arrived during the backup always stays.
    --paused-only) paused_only=1; shift ;;
    *) echo "usage: ossbot-resume --request | --offline --via V [--actor A] [--actor-uid N] [--paused-only]" >&2; exit 2 ;;
  esac
done
[[ $paused_only == 0 || $mode == offline ]] || { echo "ossbot-resume: --paused-only needs --offline" >&2; exit 2; }
[[ -n $mode ]] || { echo "usage: ossbot-resume --request | --offline --via V" >&2; exit 2; }
[[ $EUID -eq 0 ]] || { echo "ossbot-resume: must run as root" >&2; exit 2; }
log() { printf 'ossbot-resume: %s\n' "$*"; }

main() {
if [[ $mode == request ]]; then
  req="$CONTROL/resume-request"
  if [[ -L $req || ! -f $req ]]; then
    rm -f "$req"
    log "refused: resume-request is not a regular file"
    exit 1
  fi
  owner=$(stat -c %U "$req")
  if [[ $owner != gatekeeper && $owner != root ]]; then
    rm -f "$req"
    log "refused: resume-request owned by $owner"
    exit 1
  fi
  if [[ -e $CONTROL/killed && ! $req -nt $CONTROL/killed ]]; then
    rm -f "$req"
    log "refused: resume-request is older than the kill flag"
    exit 1
  fi
  via=gatekeeper
else
  via=$(printf '%s' "${via:-manual}" | tr -cd 'A-Za-z0-9_.-' | head -c 40)
  actor=$(printf '%s' "$actor" | tr -cd 'A-Za-z0-9_.@:\\-' | head -c 80)
  [[ $actor_uid =~ ^[0-9]+$ ]] || actor_uid=0
  # N4: the log line is written before anything is changed.
  install -d -o root -g ossart -m 0750 "$(dirname "$RESUME_LOG")"
  [[ -e $RESUME_LOG ]] || install -o root -g root -m 0644 /dev/null "$RESUME_LOG"
  jq -cn --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg via "$via" --arg actor "$actor" \
    --argjson uid "$actor_uid" --arg killed "$(head -c 1024 "$CONTROL/killed" 2>/dev/null | jq -c . 2>/dev/null || echo null)" \
    --argjson paused_only "$( ((paused_only)) && echo true || echo false)" \
    '{ts: $ts, event: "operator_resume_offline", via: $via, actor: $actor, actor_uid: $uid, killed: $killed}
     + (if $paused_only then {paused_only: true} else {} end)' \
    >>"$RESUME_LOG" || { log "refused: could not append to $RESUME_LOG"; exit 1; }
fi

if ((paused_only)); then
  rm -f "$CONTROL/paused"
  # A pause stops no unit, so there is nothing to start: starting the enabled units here would undo a
  # workers down (runner, Hermes, sandboxd stopped by /down, DESIGN 13.5) behind the owner's back.
  log "pause removed (paused-only, via $via); a kill flag stays; no unit started"
  exit 0
else
  rm -f "$CONTROL/killed" "$CONTROL/paused" "$CONTROL/resume-request" "$MARKER"
  # Re-arm the kill path unit (RemainAfterExit) for the next kill.
  systemctl stop ossbot-enforce-kill.service >/dev/null 2>&1 || true
  log "flags and marker removed (via $via)"
fi

failed=()
start_unit() {
  local u=$1
  systemctl cat "$u" >/dev/null 2>&1 || return 0
  systemctl is-enabled --quiet "$u" 2>/dev/null || return 0
  systemctl reset-failed "$u" >/dev/null 2>&1 || true
  if systemctl is-active --quiet "$u"; then return 0; fi
  if timeout 120 systemctl start "$u"; then log "started $u"; else failed+=("$u"); fi
}
# The Hermes probe socket has ConditionPathExists=!killed too: after a reboot while killed it was
# skipped and nothing else starts it (found by test_kill.ps1, FEAT-008).
for u in ossbot-gatekeeper.service ossbot-proxy.service ossbot-dockerfilter.service \
         ossbot-sandboxd.service ossbot-runner.service ossbot-hermes.service ossbot-hermes-probe.socket; do
  start_unit "$u"
done
if ((${#failed[@]})); then
  log "PARTIAL: did not start: ${failed[*]}"
  exit 3
fi
log "done"
exit 0
}

# Streamed over stdin (resume.ps1): nothing below may read the script stream.
main </dev/null
# shellcheck disable=SC2317  # reached when main returns instead of exiting
exit $?
