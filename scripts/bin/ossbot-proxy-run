#!/usr/bin/env bash
# ossbot-proxy-run (installed as /opt/ossbot/bin/ossbot-proxy-run; ExecStart of ossbot-proxy.service,
# DESIGN 11.2). Runs squid in the root-managed container 'ossbot-proxy' in the foreground:
# ossbot-egress at 10.212.0.2, no published ports, ip_forward=0 in its netns, unprivileged
# (uid 13 = proxy), read-only rootfs, the rendered conf read-only, logs to /srv/ossbot/logs/proxy.
# The image is the digest pinned in /etc/ossbot/versions.lock.yaml (images.proxy.digest).
set -euo pipefail

LOCK=/etc/ossbot/versions.lock.yaml
digest=$(awk '
  /^images:/ {inimg=1; next}
  inimg && /^[^ #]/ {inimg=0}
  inimg && /^  proxy:/ {inproxy=1; next}
  inimg && /^  [a-z_]+:/ {inproxy=0}
  inproxy && /^    digest:/ {gsub(/"/, "", $2); print $2; exit}
' "$LOCK")
[[ $digest =~ ^sha256:[0-9a-f]{64}$ ]] || { echo "ossbot-proxy-run: no proxy digest pinned in $LOCK" >&2; exit 1; }
[[ -f /etc/ossbot/proxy/squid.conf ]] || { echo "ossbot-proxy-run: squid.conf not rendered" >&2; exit 1; }

exec /usr/bin/docker run --rm --name ossbot-proxy --pull never \
  --network ossbot-egress --ip 10.212.0.2 --sysctl net.ipv4.ip_forward=0 \
  --user 13:13 --read-only --cap-drop ALL --security-opt no-new-privileges \
  --pids-limit 512 --memory 1g --memory-swap 1g \
  --tmpfs /run:rw,nosuid,nodev,noexec,mode=1777,size=16m \
  --tmpfs /var/spool/squid:rw,nosuid,nodev,noexec,mode=1777,size=64m \
  --tmpfs /tmp:rw,nosuid,nodev,noexec,mode=1777,size=64m \
  --mount type=bind,src=/etc/ossbot/proxy/squid.conf,dst=/etc/squid/squid.conf,readonly \
  --mount type=bind,src=/srv/ossbot/logs/proxy,dst=/var/log/squid \
  --label ossbot.role=proxy --log-driver local \
  "ossbot/proxy@$digest"
