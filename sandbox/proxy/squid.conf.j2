# ossbot squid configuration (DESIGN §11.2-11.3). RENDERED by `ossbot.ctl.render squid`; do not edit.
# Config snapshot: {{ snapshot_hash }}
# Egress mode: {{ mode }} (DESIGN §11.5; `ossctl egress mode` switches it; only sandbox_open/sandbox_full widen pool_fetch)
# CONNECT host matching only, no TLS interception. Callers: 3128 = sandboxes (profile by source
# pool), 3140/3141/3150 = host uids via the bridge (src 10.212.0.1 only).
# No DNS for a name the caller may not reach (ADR-0005 addendum, Phase 1 review P1-11/P1-12):
# every name ACL is `-n` (never a reverse lookup), IP-literal targets are denied, every deny ahead
# of the allows is a fast ACL, except the sandbox `dst` floor lines, which test the pool and the
# category first, and a `dst` ACL (resolved-IP deny) is evaluated only after the port, the source and
# the category have matched.
# Floors (ADR-0025, build-env design §4.3): attempts to reach a floor from a sandbox are marked
# (%{ossbot_floor}note) by the deny lines ahead of the port checks, so an attempt on any port counts.

{% for l in listeners -%}
http_port {{ l.bind }} name={{ l.name }}
{% endfor %}
dns_nameservers {{ nameservers | join(" ") }}
pinger_enable off
visible_hostname ossbot-proxy
cache deny all
via off
forwarded_for delete
httpd_suppress_version_string on
pid_filename /run/squid.pid
coredump_dir /var/spool/squid
# %>st bytes from the client (up), %<st bytes to the client (down), %tr ms: the per-job egress meter
# (design §13.1); %{ossbot_floor}note: the floor mark of a marked deny line, `-` when none (ADR-0025).
# rotate=0: root renames the file, then `squid -k rotate` reopens it (ossbot-proxy-rotate).
# Named options only: in the positional form (`... access.log ossbot rotate=0`) squid 6 parses
# `rotate=0` as an ACL name (src/cache_cf.cc parse_access_log, style #3).
logformat ossbot %ts.%03tu %>a %>lp %Ss/%03>Hs %rm %ru %<a %>st %<st %tr %{ossbot_floor}note
access_log stdio:/var/log/squid/access.log logformat=ossbot rotate=0
cache_log /var/log/squid/cache.log

acl SSL_ports port 443
acl Safe_ports port 80 443
acl CONNECT method CONNECT
# Cache manager pages (ipcache, active_requests) are never decided by an allow line (Phase 1 review round 5).
acl manager url_regex -i ^cache_object:// /squid-internal-mgr/
{% for l in listeners -%}
acl port_{{ l.name }} myportname {{ l.name }}
{% endfor -%}
acl src_host src {{ host_src }}
# pool_strict: fetch/validate jobs of `egress: strict` repos; the fetch base list in every egress mode.
{% for p in pools -%}
acl pool_{{ p.name }} src {{ p.cidr }}
{% endfor %}
{% for name, hosts in categories.items() -%}
acl cat_{{ name }} dstdomain -n {{ hosts | join(" ") }}
{% endfor -%}
acl denied_domains dstdomain -n {{ denied_domains | join(" ") }}
acl ip_literal dstdom_regex -n -i {{ ip_literal_patterns | join(" ") }}
# Floor marks (annotate_transaction always matches, a fast ACL; last on a deny line, it runs only when the
# rest of the line matched).
acl mark_dst annotate_transaction ossbot_floor=dst
acl mark_dst_loop annotate_transaction ossbot_floor=dst_loop
acl mark_name annotate_transaction ossbot_floor=name
acl mark_quiet annotate_transaction ossbot_floor=quiet
acl mark_literal annotate_transaction ossbot_floor=literal
acl mark_code annotate_transaction ossbot_floor=code
# always-denied names that are telemetry, not a write channel: denied and noted, never held
acl notify_only dstdomain -n {{ notify_only | join(" ") }}
# the repo-code pools (pool_fetch: fetch, validate, agent-exec; pool_strict) and the names they never reach
acl code_pools src {{ code_pool_cidrs | join(" ") }}
acl code_denied dstdomain -n {{ code_denied | join(" ") }}
# the address floors, split: loopback can only reach the proxy's own netns (a note), the rest holds
acl denied_dst_loop dst {{ loop_cidrs | join(" ") }}
acl denied_dst dst {{ denied_cidrs_non_loop | join(" ") }}{% for h in host_cidrs %} {{ h }}{% endfor %}
# the public-address floor (ossbot-pubip): a second definition line of the same ACL adds the file's values;
# the file is never empty (sentinel 240.0.0.1/32, already a floor) and is re-read on SIGHUP
acl denied_dst dst "/etc/squid/floor/public.txt"
# fail closed: the repo-code pool CIDRs while the public floor is known, else the sentinel 255.255.255.255/32
acl code_web_ok src "/etc/squid/floor/code-web.txt"

# --- sandbox port: floor attempts are marked BEFORE any port check, so an attempt on any port counts
http_access deny port_sandbox notify_only mark_quiet
http_access deny port_sandbox denied_domains mark_name
http_access deny port_sandbox ip_literal mark_literal
http_access deny port_sandbox code_pools code_denied mark_code
{% for r in sandbox_rules -%}
http_access deny port_sandbox {{ r.src }} {{ r.dst }} denied_dst mark_dst
http_access deny port_sandbox {{ r.src }} {{ r.dst }} denied_dst_loop mark_dst_loop
{% endfor -%}
http_access deny !Safe_ports
http_access deny CONNECT !SSL_ports
http_access deny manager
{% for r in pre_deny_rules -%}
# §14.12.8: the gatekeeper's opt-in Telegraph egress (rendered only while telegraph.enabled is true)
http_access allow port_{{ r.port }} {{ r.src }} {{ r.dst }} !ip_literal !denied_dst_loop !denied_dst
{% endfor -%}
http_access deny denied_domains
http_access deny ip_literal
# 3128 serves only the task pools, never the host side of the bridge.
http_access deny port_sandbox src_host
{% for r in rules -%}
http_access allow port_{{ r.port }} {{ r.src }}{% if r.src == code_pool_src and r.dst == "all" %} code_web_ok{% endif %} {{ r.dst }} !denied_dst_loop !denied_dst
{% endfor -%}
http_access deny all
