# Hermes v0.22.2 managed scope: /etc/hermes/config.yaml (root:root 0644). Rendered by root
# (python -I -m ossbot.ctl.hermes_render) for capability tier "{{ tier }}"; never edit by hand.
# Hermes documents this layer as winning over ~/.hermes/config.yaml and the environment, per leaf
# (lists are replaced whole). DESIGN §15.1, §15.5; ADR-0002 and ADR-0018 addenda (FEAT-007).
model:
  provider: kiro-acp            # vendored hermes-kiro-provider fork, V3 ACP (HERMES_KIRO_ACP_ENGINE)
  default: kiro-acp             # the provider resolves the real model from config/models.yaml per turn
  # Images go to the provider as image parts; it sends them as ACP image blocks on roles.vision.
  # Without this Hermes knows no "kiro-acp" vision capability and pre-describes every image through
  # its auxiliary vision call instead (FEAT-007 review round 2, F007-R2-1).
  supports_vision: true
  # Hermes cannot look up the window of "kiro-acp" (it warned "Could not determine context length");
  # policy.yaml hermes.context_length (ADR-0002 addendum post-v1).
  context_length: {{ context_length }}
auxiliary:
  title_generation:
    enabled: true
    # Keep the instant derived title; never a second Kiro turn or the background "auto-title" thread
    # whose lazy openai import deadlocked (_ModuleLock('openai.types')) (ADR-0002 addendum post-v1).
    model_upgrade_enabled: false
platform_toolsets:
  api_server: [{{ toolsets | join(", ") }}]
agent:
  # applied after platform_toolsets; "always removed" (configuration.md "Global Toolset Disable")
  disabled_toolsets: [{{ disabled | join(", ") }}]
  image_input_mode: native      # never the lossy vision_analyze pre-description (image_routing.py)
{% if github_tools %}
# GHMCP-4: the read-only GitHub MCP server (tiers research and self_improve). ossbot-github-mcp starts
# github-mcp-server with fixed --read-only flags after a startup check that refuses any write tool; the
# read token comes from hermes.env; egress only through squid 3141.
mcp_servers:
  github:
    command: /opt/ossbot/bin/ossbot-github-mcp
    args: []
    env:
      GITHUB_READ_TOKEN: "${GITHUB_READ_TOKEN}"
      HOME: /home/hermes
      HTTPS_PROXY: http://10.212.0.2:3141
      https_proxy: http://10.212.0.2:3141
    tools:
      include: [{{ github_tools | join(", ") }}]
{% else %}
mcp_servers: {}
{% endif %}
tools:
  tool_search:
    enabled: "off"              # M8: no tool_search/tool_describe/tool_call bridge
approvals:
  mode: manual                  # defence in depth only: no terminal or code toolset exists to approve
  cron_mode: deny
  unattended_mode: deny
updates:
  check: false
plugins:
  enabled: [ossbot]
  auto_update_check_hours: 0
curator:
  enabled: false                # no background skill maintenance; every skill change is staged
skills:
  write_approval: true          # skill_manage stages to ~/.hermes/pending/skills/; root activates (§15.5)
  project_discovery: false
  trusted_project_dirs: []
  create_dir: ""
  external_dirs: []
  inline_shell: false
  ledger: false
gateway:
  api_server:
    host: 127.0.0.1
    port: 8642
