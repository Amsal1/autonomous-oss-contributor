# Watchdog tick (DESIGN §13.2, §13.4), root, every 30 s via ossbot-watchdog.timer: invariants
# (control/secret/socket modes), firewall --check, kill re-enforcement, gatekeeper health, anchors.
# Never starts or restarts ossbot units while killed or paused.
[Unit]
Description=ossbot watchdog tick
After=ossbot-boot-gate.service

[Service]
# CR-001: >= drain timeout (120 s) + 30 s, so a graceful stop is never cut short by systemd.
TimeoutStopSec=150
Type=oneshot
ExecStart=/opt/ossbot/app/.venv/bin/python -I -m ossbot.watchdog.tick
WorkingDirectory=/
TimeoutStartSec=25
