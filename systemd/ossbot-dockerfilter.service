# Docker API filter (DESIGN §10.8), root. Refuses every container create/start while killed or
# paused, so it keeps running through every kill level (§13.1).
[Unit]
Description=ossbot Docker API filter
Requires=ossbot-boot-gate.service
Wants=docker.service
After=ossbot-boot-gate.service docker.service ossbot-firewall-docker.service

[Service]
# CR-001: >= drain timeout (120 s) + 30 s, so a graceful stop is never cut short by systemd.
TimeoutStopSec=150
Type=simple
ExecStart=/opt/ossbot/app/.venv/bin/ossbot-dockerfilter --listen /run/ossbot/docker-filter.sock --docker /var/run/docker.sock --control-dir /var/lib/ossbot/control --images-lock /etc/ossbot/versions.lock.yaml
Restart=always
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/run/ossbot
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
