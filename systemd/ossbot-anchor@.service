# One audit anchor per connection on /run/ossbot/anchor.sock (root). The payload is ignored.
[Unit]
Description=ossbot audit anchor (per connection)

[Service]
# CR-001: >= drain timeout (120 s) + 30 s, so a graceful stop is never cut short by systemd.
TimeoutStopSec=150
Type=oneshot
ExecStart=/opt/ossbot/app/.venv/bin/python -I -m ossbot.watchdog.anchors --serve-one
StandardInput=socket
StandardOutput=socket
StandardError=journal
WorkingDirectory=/
TimeoutStartSec=15
