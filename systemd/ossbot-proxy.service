# Egress proxy (DESIGN §11.2): squid in the root-managed container ossbot-proxy on ossbot-egress at
# 10.212.0.2, no published ports, ip_forward=0 in its netns. squid.conf is rendered from the
# gatekeeper's config snapshot and the live resolver. Runs after a soft kill, skipped after a full
# kill (ExecCondition).
[Unit]
Description=ossbot egress proxy (squid)
Requires=ossbot-boot-gate.service docker.service ossbot-firewall.service ossbot-firewall-docker.service
# ADR-0025: the first public-address lookup runs before the proxy starts (a failed one leaves the floor
# unknown: fail closed, repo code has no public web until it is known)
Wants=ossbot-pubip.service
After=ossbot-boot-gate.service docker.service ossbot-firewall.service ossbot-firewall-docker.service ossbot-gatekeeper.service ossbot-pubip.service

[Service]
# CR-001: >= drain timeout (120 s) + 30 s, so a graceful stop is never cut short by systemd.
TimeoutStopSec=150
Type=simple
ExecCondition=/opt/ossbot/bin/ossbot-boot-gate --allow minimal
# Render first (snapshot + the egress-mode flag, §11.5): --check compares the live conf with it.
ExecStartPre=/opt/ossbot/app/.venv/bin/python -I -m ossbot.ctl.render squid --out /etc/ossbot/proxy/squid.conf
ExecStartPre=+/opt/ossbot/bin/ossbot-firewall --check
ExecStartPre=-/usr/bin/docker rm --force ossbot-proxy
ExecStart=/opt/ossbot/bin/ossbot-proxy-run
# squid waits shutdown_lifetime (30 s) on SIGTERM; it holds no state, so docker kills it after 2 s.
ExecStop=/usr/bin/docker stop --time 2 ossbot-proxy
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
