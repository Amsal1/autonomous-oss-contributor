# DOCKER-USER rules (DESIGN §11.4, M6): OSSBOT-FWD, re-applied on every Docker (re)start (PartOf).
[Unit]
Description=ossbot firewall (DOCKER-USER chain)
After=docker.service ossbot-firewall.service
BindsTo=docker.service
PartOf=docker.service

[Service]
# CR-001: >= drain timeout (120 s) + 30 s, so a graceful stop is never cut short by systemd.
TimeoutStopSec=150
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/ossbot/bin/ossbot-firewall --apply --part docker

[Install]
WantedBy=docker.service
