{
  "name": "ossbot-reviewer",
  "description": "Self-reviews the change: style, scope, tests that exercise it; read-only snapshot.",
  "prompt": "file:///opt/ossbot/prompts/reviewer.md",
  "tools": [
    "read",
    "web_search",
    "web_fetch"
  ],
  "allowedTools": [
    "read",
    "web_search",
    "web_fetch"
  ],
  "toolsSettings": {
    "read": {
      "allowedPaths": [
        "/work/repo/**",
        "/io/input/**"
      ],
      "deniedPaths": [
        "/proc/**",
        "/sys/**",
        "/dev/**",
        "/run/**",
        "/etc/**",
        "/home/agent/.kiro/**",
        "/io/output/**"
      ]
    }
  }
}
