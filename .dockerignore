# Build context for sandbox/images/* is the repo root (scripts/lib/images.sh). Only what the
# Dockerfiles COPY is sent; never the VHD under .wsl/, local state or anything personal.
*
!sandbox/entrypoints/
!sandbox/fixtures/
!sandbox/gradle/
!sandbox/images/full/code-requirements.txt
!sandbox/images/full-base/mise.toml
!sandbox/images/full-base/mise.lock
!sandbox/kiro/
!sandbox/probes/
!src/ossbot/sandbox_tools/
!.kiro/agents/
# the repo-development agent is not a sandbox role and never enters an image
.kiro/agents/harness-dev.json
!prompts/
